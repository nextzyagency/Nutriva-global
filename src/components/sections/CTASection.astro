---
import { contact } from '../../data/site';

const terms = [
  'Mínimos de pedido flexibles',
  'Precios especiales para distribuidores',
  'Soporte logístico internacional',
  'Documentación de origen y análisis en cada pedido',
  'Private label disponible',
];
---

<section class="section section--band" id="mayoristas-cta" aria-labelledby="cta-title">
  <div class="wrap cta-grid">
    <div>
      <h2 id="cta-title">¿Llevamos Nutriva a tu mercado?</h2>
      <p class="cta-lede">Cuéntanos dónde distribuyes y qué volúmenes manejas. Te enviamos la propuesta comercial y las fichas técnicas en menos de 24 horas hábiles.</p>
      <div class="cta-actions">
        <a href="/contacto#propuesta" class="btn btn--light">
          Solicitar propuesta
          <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href={contact.whatsappWithText} target="_blank" rel="noopener noreferrer" class="btn btn--ghost-light">
          Hablar por WhatsApp
        </a>
      </div>
    </div>

    <ul class="terms" role="list" aria-label="Condiciones para distribuidores">
      {terms.map((t) => (
        <li>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          {t}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.cta-grid {
  display: grid;
  grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  gap: clamp(2.5rem, 6vw, 6rem);
  align-items: center;
}
.cta-grid h2 { font-size: clamp(2.25rem, 4.6vw, 4rem); font-weight: 800; max-width: 11em; }
.cta-lede { margin-top: 1.25rem; color: var(--band-soft); font-size: 1.125rem; max-width: 32em; }
.cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

.terms { list-style: none; padding: 0; margin: 0; }
.terms li {
  display: flex;
  align-items: center;
  gap: 0.875rem;
  padding: 1rem 0;
  border-bottom: 1px solid var(--band-line);
  font-size: 1.0625rem;
  font-weight: 500;
}
.terms li:first-child { border-top: 1px solid var(--band-line); }
.terms svg { color: var(--field-sage); flex-shrink: 0; }

.section--band :global(:focus-visible) { outline-color: var(--field-sage); }

@media (max-width: 860px) {
  .cta-grid { grid-template-columns: 1fr; }
}
</style>
