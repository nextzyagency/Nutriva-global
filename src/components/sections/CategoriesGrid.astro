---
import { Image } from 'astro:assets';
import products from '../../data/products.json';
import imgAlimentos from '../../assets/category_alimentos.png';
import imgPlantbased from '../../assets/category_plantbased.png';
import imgSuperfoods from '../../assets/category_superfoods.png';
import imgGlobal from '../../assets/category_global.png';

const categories = products.categories;

const imageMap: Record<string, ImageMetadata> = {
  category_alimentos: imgAlimentos,
  category_plantbased: imgPlantbased,
  category_superfoods: imgSuperfoods,
  category_global: imgGlobal,
};
---

<section class="categories section-pad bg-gray-soft" id="categorias" aria-label="Categorías de productos">
  <div class="container-xl">

    <div class="cat-header gsap-reveal">
      <p class="section-label">Nuestro Catálogo</p>
      <h2>Cuatro líneas, un mismo propósito</h2>
      <p class="cat-subtitle">Cada categoría diseñada para un estilo de vida consciente, con ingredientes certificados y distribución en todo el mundo.</p>
      <div class="divider-gold"></div>
    </div>

    <div class="categories-grid">
      {categories.map((cat, i) => (
        <a
          href={`/productos/${cat.id}`}
          title={`Ver productos ${cat.name} - Nutriva Global`}
          class="category-card gsap-reveal"
          data-delay={i * 0.1}
          aria-label={`Categoría ${cat.name}: ${cat.description}`}
        >
          <div class="cat-image-wrap">
            <Image
              src={imageMap[cat.image]}
              alt={cat.alt}
              width={500}
              height={320}
              loading="lazy"
              class="cat-img"
            />
            <div class="cat-overlay" aria-hidden="true"></div>
          </div>
          <div class="cat-content">
            <div class="cat-tag" style={`border-color: ${cat.color}; color: ${cat.color};`}>
              Ver categoría
            </div>
            <h3 class="cat-name">{cat.name}</h3>
            <p class="cat-desc">{cat.description}</p>
            <div class="cat-arrow" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
.categories {
  border-top: 1px solid var(--gray-mid);
}

.cat-header {
  text-align: center;
  margin-bottom: 3.5rem;
}

.cat-header h2 { margin-bottom: 0.75rem; }

.cat-subtitle {
  max-width: 500px;
  margin: 0 auto;
  font-size: 1rem;
}

.cat-header .divider-gold { margin: 1.25rem auto 0; }

.categories-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}

.category-card {
  display: block;
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  background: white;
  border: 1px solid var(--gray-mid);
  transition: all var(--transition);
  text-decoration: none;
}

.category-card:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-6px);
  border-color: rgba(31,122,99,0.2);
}

.cat-image-wrap {
  position: relative;
  aspect-ratio: 16/9;
  overflow: hidden;
}

.cat-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.category-card:hover .cat-img { transform: scale(1.06); }

.cat-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 30%, rgba(31,122,99,0.15) 100%);
}

.cat-content {
  padding: 1.5rem 1.75rem 1.75rem;
}

.cat-tag {
  display: inline-block;
  font-family: var(--font-heading);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 0.25rem 0.75rem;
  border-radius: 100px;
  border: 1.5px solid;
  margin-bottom: 0.75rem;
  transition: all var(--transition);
}

.category-card:hover .cat-tag {
  background-color: var(--verde-deep);
  border-color: var(--verde-deep);
  color: white;
}

.cat-name {
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--carbon);
  margin-bottom: 0.4rem;
  line-height: 1.2;
  transition: color var(--transition);
}

.category-card:hover .cat-name { color: var(--verde-deep); }

.cat-desc {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 1rem;
}

.cat-arrow {
  display: flex;
  align-items: center;
  color: var(--verde-deep);
  transform: translateX(0);
  transition: transform var(--transition);
}

.category-card:hover .cat-arrow { transform: translateX(6px); }

@media (max-width: 640px) {
  .categories-grid { grid-template-columns: 1fr; }
}
</style>
