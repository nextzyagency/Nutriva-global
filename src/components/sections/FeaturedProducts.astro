---
import { Image } from 'astro:assets';
import products from '../../data/products.json';
import { images, lineById } from '../../data/site';

const featured = products.featured;
---

<section class="section" id="productos-destacados" aria-labelledby="fp-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="fp-title">Los más pedidos por nuestros distribuidores</h2>
      <p class="lede">Productos con rotación probada, listos para lineal. Pide muestras con tu propuesta.</p>
    </div>

    <ul class="products" role="list">
      {featured.map((product) => {
        const line = lineById(product.categorySlug);
        return (
          <li class="product" style={`--field:${line.field}`}>
            <div class="product-media">
              <Image src={images[product.image]} alt={product.alt} widths={[360, 540, 720]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 400px" loading="lazy" class="product-img" />
              <span class={`product-tag ${product.badge === 'Nuevo' ? 'product-tag--new' : ''}`}>{product.badge}</span>
            </div>
            <div class="product-body">
              <h3 class="product-name">{product.name}</h3>
              <p class="product-desc">{product.description}</p>
              <ul class="product-benefits" role="list">
                {product.benefits.map((b) => <li class="chip">{b}</li>)}
              </ul>
              <div class="product-foot">
                <p class="product-price"><strong>{product.price}</strong> <span>/ {product.unit} · PVP ref.</span></p>
                <a href={`/productos/${product.categorySlug}`} class="link-arrow" aria-label={`Ver ${product.name}`}>
                  Ver ficha
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
.products {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(1.25rem, 2.5vw, 2rem);
}

.product { display: flex; flex-direction: column; }

.product-media {
  position: relative;
  aspect-ratio: 1;
  border-radius: var(--radius-img);
  overflow: hidden;
  background: var(--field);
}
.product-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 700ms var(--ease-out);
}
.product:hover .product-img { transform: scale(1.035); }

.product-tag {
  position: absolute;
  top: 1rem;
  left: 1rem;
  padding: 0.35rem 0.8rem;
  border-radius: var(--radius-ctl);
  background: var(--paper);
  font-size: 0.8125rem;
  font-weight: 700;
}
.product-tag--new { background: var(--ink); color: var(--paper); }

.product-body {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex: 1;
  padding-top: 1.25rem;
}
.product-name { font-size: 1.5rem; }
.product-desc { color: var(--ink-soft); font-size: 1rem; }
.product-benefits { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0; }

.product-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  margin-top: auto;
  padding-top: 1rem;
  border-top: 1px solid var(--line);
}
.product-price { font-variant-numeric: tabular-nums; color: var(--ink-faint); font-size: 0.875rem; }
.product-price strong {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--ink);
}

@media (max-width: 1100px) { .products { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 700px)  { .products { grid-template-columns: 1fr; } }
</style>
