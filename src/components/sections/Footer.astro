---
import { contact, lines } from '../../data/site';

const company = [
  { href: '/nosotros', label: 'Sobre nosotros' },
  { href: '/contacto', label: 'Contacto' },
  { href: '/contacto#propuesta', label: 'Distribuidores' },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Nutriva Global, inicio">Nutriva<span>Global</span></a>
        <p>Nutriendo el mundo, naturalmente. Alimentos saludables, sostenibles y accesibles para distribuidores de todo el mundo, desde Ámsterdam.</p>
      </div>

      <nav class="footer-col" aria-labelledby="f-products">
        <h2 id="f-products" class="footer-heading">Productos</h2>
        <ul role="list">
          {lines.map((l) => <li><a href={`/productos/${l.id}`}>{l.name}</a></li>)}
        </ul>
      </nav>

      <nav class="footer-col" aria-labelledby="f-company">
        <h2 id="f-company" class="footer-heading">Empresa</h2>
        <ul role="list">
          {company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="footer-heading">Contacto</h2>
        <ul role="list">
          <li><a href={contact.whatsapp} target="_blank" rel="noopener noreferrer">{contact.phone}</a></li>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li>{contact.city}</li>
        </ul>
        <ul role="list" class="footer-social">
          <li><a href={contact.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
          <li><a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Nutriva Global. Todos los derechos reservados.</p>
      <p>Ámsterdam, Países Bajos</p>
    </div>
  </div>
</footer>

<style>
.footer {
  background: var(--band);
  color: var(--band-soft);
  padding-top: clamp(4rem, 8vw, 6rem);
  overflow: hidden;
}

.footer-top {
  display: grid;
  grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
  gap: 2.5rem;
}

.footer-logo {
  display: inline-flex;
  align-items: baseline;
  gap: 0.35rem;
  font-family: var(--font-display);
  font-size: 1.75rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--band-text);
}
.footer-logo span { font-family: var(--font-body); font-size: 1rem; font-weight: 500; letter-spacing: 0; color: var(--band-soft); }
.footer-brand p { margin-top: 1rem; max-width: 26em; }

.footer-heading {
  font-family: var(--font-body);
  font-size: 0.875rem;
  font-weight: 700;
  letter-spacing: 0;
  color: var(--band-text);
  margin-bottom: 1rem;
}
.footer-col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
.footer-col a { transition: color 160ms var(--ease-out); }
.footer-col a:hover { color: var(--band-text); text-decoration: underline; text-underline-offset: 0.25em; }
.footer-social { margin-top: 1.25rem !important; }

.footer :global(:focus-visible) { outline-color: var(--field-sage); }

.footer-bottom {
  margin-top: clamp(3rem, 6vw, 4.5rem);
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  padding-block: 1.5rem;
  border-top: 1px solid var(--band-line);
  font-size: 0.875rem;
}

@media (max-width: 860px) {
  .footer-top { grid-template-columns: 1fr 1fr; }
  .footer-brand { grid-column: 1 / -1; }
}
@media (max-width: 480px) {
  .footer-top { grid-template-columns: 1fr; }
}
</style>
