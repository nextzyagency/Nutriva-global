---
import { Image } from 'astro:assets';
import heroImg from '../../assets/hero_nutriva.png';
import { contact, lines } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title" class="reveal-up">Alimentos saludables globales para tu mercado</h1>
      <p class="lede reveal-up" style="--d:80ms">
        Snacks orgánicos, plant-based y superfoods para distribuidores, importadores y retailers. Un solo proveedor, trazabilidad por lote y documentación en cada pedido.
      </p>

      <form class="quote reveal-up" style="--d:160ms" action={contact.formAction} method="POST" aria-labelledby="quote-title">
        <h2 id="quote-title" class="quote-title">Pide la propuesta mayorista</h2>
        <input type="hidden" name="_subject" value="Solicitud de propuesta mayorista (home) - Nutriva Global" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value="https://www.nutrivaglobal.com/contacto?success=true" />
        <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="quote-fields">
          <div class="field">
            <label for="q-email">Email de trabajo</label>
            <input id="q-email" name="email" type="email" class="input" placeholder="compras@tuempresa.com" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="q-pais">País de distribución</label>
            <input id="q-pais" name="pais" type="text" class="input" placeholder="Ej. Alemania" autocomplete="country-name" required />
          </div>
          <div class="field">
            <label for="q-linea">Línea de interés</label>
            <select id="q-linea" name="linea" class="input">
              <option value="Todas">Todas las líneas</option>
              {lines.map((l) => <option value={l.name}>{l.name}</option>)}
            </select>
          </div>
          <button type="submit" class="btn btn--primary quote-submit">
            Solicitar propuesta
            <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
        <p class="quote-note">
          Un asesor responde en menos de 24 h hábiles. ¿Prefieres hablar ya?
          <a href={contact.whatsappWithText} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>.
        </p>
      </form>
    </div>

    <div class="hero-media">
      <div class="hero-frame reveal-img">
        <Image
          src={heroImg}
          alt="Batido verde, quinoa, chía, frutos secos y barras proteicas Nutriva sobre una mesa de mármol"
          widths={[480, 720, 960]}
          sizes="(max-width: 960px) 100vw, 46vw"
          loading="eager"
          fetchpriority="high"
          class="hero-img"
        />
      </div>
    </div>
  </div>

  <div class="wrap">
    <ul class="hero-lines" role="list" aria-label="Líneas de producto">
      {lines.map((l) => (
        <li>
          <a href={`/productos/${l.id}`} style={`--field:${l.field}`}>
            <span>{l.name}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.hero {
  padding-top: clamp(1.5rem, 3.5vw, 3rem);
  padding-bottom: clamp(3rem, 6vw, 5rem);
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  gap: clamp(2rem, 5vw, 4.5rem);
  align-items: center;
}

.hero-copy h1 { max-width: 12em; font-size: clamp(2.5rem, 4.6vw, 4.25rem); }
.hero-copy .lede { margin-top: 1.25rem; }

.quote {
  margin-top: clamp(1.5rem, 3vw, 2rem);
  padding: 1.5rem;
  border: 1px solid var(--line);
  border-radius: var(--radius-img);
  background: var(--oat);
  max-width: 40rem;
}
.quote-title {
  font-size: 1.25rem;
  letter-spacing: -0.015em;
  margin-bottom: 1rem;
  font-variation-settings: "opsz" 24;
}
.quote-fields {
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr;
  gap: 0.75rem;
  align-items: end;
}
.quote-submit { grid-column: 1 / -1; width: 100%; min-height: 3.25rem; font-size: 1.0625rem; }

@media (max-width: 1200px) {
  .quote-fields { grid-template-columns: 1fr 1fr; }
  .quote-fields .field:first-child { grid-column: 1 / -1; }
}
.quote-note {
  margin-top: 0.875rem;
  font-size: 0.9rem;
  color: var(--ink-soft);
}
.quote-note a {
  color: var(--green);
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 0.25em;
  text-decoration-thickness: 1.5px;
}

.hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

.hero-media { position: relative; }
.hero-frame {
  position: relative;
  aspect-ratio: 4 / 5;
  max-height: calc(100dvh - 140px);
  margin-left: auto;
  border-radius: var(--radius-img);
  overflow: hidden;
  background: var(--field-sage);
}
.hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 42% 60%;
}

.hero-lines {
  list-style: none;
  padding: 0;
  margin: clamp(2.5rem, 5vw, 4rem) 0 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.75rem;
}
.hero-lines a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.15rem 1.25rem;
  border-radius: var(--radius-card);
  background: var(--field);
  font-family: var(--font-display);
  font-size: 1.1875rem;
  font-weight: 700;
  letter-spacing: -0.015em;
  font-variation-settings: "opsz" 24;
  transition: transform 260ms var(--ease-out);
}
.hero-lines a svg { transition: transform 260ms var(--ease-out); }
.hero-lines a:hover svg { transform: translate(2px, -2px); }

@media (max-width: 960px) {
  .hero-grid { grid-template-columns: 1fr; }
  .hero-frame { aspect-ratio: 4 / 3; max-height: none; }
  .hero-lines { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 520px) {
  .quote { padding: 1.125rem; }
  .quote-fields { grid-template-columns: 1fr; }
  .hero-lines a { font-size: 1.0625rem; padding: 1rem; }
}
</style>
