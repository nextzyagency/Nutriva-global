---
import { Image } from 'astro:assets';
import products from '../../data/products.json';
import { lineById } from '../../data/site';

const categories = products.categories;
---

<section class="section section--oat" id="categorias" aria-labelledby="cat-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="cat-title">Cuatro líneas, un mismo proveedor</h2>
      <p class="lede">Cada línea con ingredientes trazados y documentación por lote. Consolida tu pedido en un solo envío.</p>
    </div>

    <div class="lines">
      {categories.map((cat, i) => {
        const line = lineById(cat.id);
        return (
          <article class={`line ${i % 2 ? 'line--flip' : ''}`} style={`--field:${line.field}`} aria-labelledby={`line-${cat.id}`}>
            <a href={`/productos/${cat.id}`} class="line-media" tabindex="-1" aria-hidden="true">
              <Image src={line.image} alt="" widths={[400, 640, 880]} sizes="(max-width: 860px) 100vw, 40vw" loading="lazy" class="line-img" />
            </a>
            <div class="line-body">
              <h3 id={`line-${cat.id}`} class="line-name">
                <a href={`/productos/${cat.id}`}>{cat.name}</a>
              </h3>
              <p class="line-desc">{cat.description}</p>
              <table class="line-table">
                <caption class="sr-only">Productos de {cat.name}</caption>
                <thead>
                  <tr><th scope="col">Producto</th><th scope="col">Formato</th><th scope="col">PVP ref.</th></tr>
                </thead>
                <tbody>
                  {cat.products.map((p) => (
                    <tr><th scope="row">{p.name}</th><td>{p.unit}</td><td>{p.price}</td></tr>
                  ))}
                </tbody>
              </table>
              <a href={`/productos/${cat.id}`} class="link-arrow">
                Ver {cat.name}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
.lines { display: grid; gap: clamp(1rem, 2vw, 1.5rem); }

.line {
  display: grid;
  grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  border-radius: var(--radius-img);
  background: var(--paper);
  overflow: hidden;
}
.line--flip { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
.line--flip .line-media { order: 2; }

.line-media {
  display: block;
  background: var(--field);
  min-height: 100%;
  overflow: hidden;
}
.line-img {
  width: 100%;
  height: 100%;
  aspect-ratio: 5 / 4;
  object-fit: cover;
  transition: transform 700ms var(--ease-out);
}
.line:hover .line-img { transform: scale(1.03); }

.line-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1rem;
  padding: clamp(1.5rem, 3.5vw, 3rem);
  border-top: 8px solid var(--field);
}
.line-name { font-size: clamp(1.75rem, 2.8vw, 2.5rem); font-variation-settings: "opsz" 72; }
.line-name a:hover { color: var(--green); }
.line-desc { color: var(--ink-soft); max-width: 36em; }

.line-table {
  width: 100%;
  border-collapse: collapse;
  font-variant-numeric: tabular-nums;
  font-size: 0.9375rem;
  margin-block: 0.25rem 0.5rem;
}
.line-table thead th {
  text-align: left;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--ink-faint);
  padding: 0 0 0.5rem;
  border-bottom: 1px solid var(--line-strong);
}
.line-table tbody th { text-align: left; font-weight: 600; }
.line-table tbody th,
.line-table td { padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
.line-table td { color: var(--ink-soft); }
.line-table th:nth-child(n+2),
.line-table td { text-align: right; padding-left: 1rem; white-space: nowrap; }

@media (max-width: 860px) {
  .line, .line--flip { grid-template-columns: 1fr; }
  .line--flip .line-media { order: 0; }
  .line-img { aspect-ratio: 16 / 9; }
}
</style>
