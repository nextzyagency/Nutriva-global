---
import ExampleNote from '../ui/ExampleNote.astro';
import Figures from '../ui/Figures.astro';

const testimonials = [
  {
    quote: 'Nutriva Global transformó nuestra línea de productos saludables. La calidad es excepcional y la logística internacional es impecable. Nuestros clientes en Europa y LATAM aman los sabores.',
    author: 'María González',
    role: 'Directora de Compras, BioMarket España',
  },
  {
    quote: 'Distribuimos los superfoods de Nutriva Global en Japón y la respuesta ha sido increíble. Las certificaciones orgánicas y el packaging los diferencian del mercado.',
    author: 'Kenji Tanaka',
    role: 'CEO, NaturaShop Japan',
  },
  {
    quote: 'Llevamos 2 años trabajando con Nutriva como proveedor mayorista. Siempre cumplen los tiempos, la calidad es consistente y el soporte es de primer nivel.',
    author: 'Carlos Medina',
    role: 'Gerente de Operaciones, Salud+, Colombia',
  },
];

const figures = [
  { num: '20+', label: 'países con distribución activa en Europa, LATAM, Asia y Norteamérica' },
  { num: '50k+', label: 'clientes entre consumidores finales y mayoristas' },
  { num: '98 %', label: 'índice de satisfacción de distribuidores' },
];

const certs = ['Organic EU', 'Non-GMO Verified', 'Vegan Society', 'ISO 22000', 'HACCP'];

const [lead, ...rest] = testimonials;
---

<section class="section" id="testimonios" aria-labelledby="proof-title">
  <div class="wrap">
    <div class="proof-grid">
      <div class="proof-main">
        <h2 id="proof-title">Lo que dicen quienes ya distribuyen Nutriva</h2>

        <figure class="lead-quote">
          <blockquote><p>{lead.quote}</p></blockquote>
          <figcaption><strong>{lead.author}</strong> · {lead.role}</figcaption>
        </figure>

        <div class="quotes">
          {rest.map((t) => (
            <figure class="quote">
              <blockquote><p>{t.quote}</p></blockquote>
              <figcaption><strong>{t.author}</strong><span>{t.role}</span></figcaption>
            </figure>
          ))}
        </div>
        <ExampleNote text="Testimonios de ejemplo" />
      </div>

      <aside class="proof-side" aria-label="Cifras y certificaciones">
        <Figures figures={figures} />
        <div class="certs">
          <h3 class="certs-title">Certificaciones</h3>
          <ul role="list" class="certs-list">
            {certs.map((c) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                {c}
              </li>
            ))}
          </ul>
          <ExampleNote />
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
.proof-grid {
  display: grid;
  grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
  gap: clamp(2.5rem, 6vw, 6rem);
}

.proof-main h2 { max-width: 13em; margin-bottom: clamp(2rem, 4vw, 3rem); }

.lead-quote { margin: 0 0 2.5rem; }
.lead-quote blockquote { margin: 0; }
.lead-quote p {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 2.6vw, 2.125rem);
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.02em;
  font-variation-settings: "opsz" 48;
  text-indent: -0.45em;
}
.lead-quote p::before { content: '“'; }
.lead-quote p::after { content: '”'; }
.lead-quote figcaption { margin-top: 1.25rem; color: var(--ink-soft); }
.lead-quote figcaption strong { color: var(--ink); }

.quotes {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  padding-top: 2rem;
  border-top: 1px solid var(--line-strong);
  margin-bottom: 1rem;
}
.quote { margin: 0; }
.quote blockquote { margin: 0; }
.quote p { color: var(--ink); }
.quote p::before { content: '“'; }
.quote p::after { content: '”'; }
.quote figcaption { margin-top: 1rem; display: grid; font-size: 0.9375rem; }
.quote figcaption span { color: var(--ink-faint); }

.certs { margin-top: 2.5rem; }
.certs-title { font-size: 1.125rem; margin-bottom: 0.75rem; }
.certs-list { list-style: none; padding: 0; margin: 0 0 0.75rem; display: grid; gap: 0.5rem; }
.certs-list li { display: flex; align-items: center; gap: 0.6rem; font-weight: 600; }
.certs-list svg { color: var(--green); }

@media (max-width: 960px) {
  .proof-grid { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .quotes { grid-template-columns: 1fr; }
}
</style>
