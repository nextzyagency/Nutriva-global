---
import { SHOW_EXAMPLE_NOTES } from '../../data/site';

interface Props { text?: string; class?: string }
const { text = 'Datos de ejemplo', class: className = '' } = Astro.props;
---

{SHOW_EXAMPLE_NOTES && (
  <span class={`example-note ${className}`}>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
    {text}
  </span>
)}
