---
// LoadingScreen.astro — Pantalla de carga global de Nutriva Global
---

<div id="page-loader" role="status" aria-label="Cargando Nutriva Global" aria-live="polite">
  <div class="loader-wrap">

    <!-- Logo / Marca -->
    <div class="loader-brand">
      <div class="loader-emblem" aria-hidden="true">
        <svg width="52" height="52" viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="26" cy="26" r="24" stroke="#6BCB77" stroke-width="2" opacity="0.3"/>
          <path d="M26 10 C26 10 16 20 16 30 C16 37.732 20.477 44 26 44 C31.523 44 36 37.732 36 30 C36 20 26 10 26 10Z"
                fill="#1F7A63" opacity="0.9"/>
          <path d="M26 16 C26 16 20 24 20 30 C20 33.314 22.686 36 26 36 C29.314 36 32 33.314 32 30 C32 24 26 16 26 16Z"
                fill="#6BCB77"/>
          <circle cx="26" cy="30" r="4" fill="#D4AF37"/>
        </svg>
      </div>
      <div class="loader-text">
        <span class="loader-name">Nutriva<span class="loader-name-accent"> Global</span></span>
        <span class="loader-tagline">Alimentos Saludables del Mundo</span>
      </div>
    </div>

    <!-- Barra de progreso -->
    <div class="loader-bar-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
      <div class="loader-bar-fill" id="loader-bar-fill"></div>
    </div>

    <!-- Spinner de actividad -->
    <div class="loader-spinner" aria-hidden="true">
      <div class="spinner-ring"></div>
    </div>

  </div>
</div>

<style>
  /* ── Overlay ────────────────────────────────────────────── */
  #page-loader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: linear-gradient(135deg, #1a2e25 0%, #0f1e18 50%, #1a2415 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.65s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.65s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }

  /* Grano de fondo */
  #page-loader::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(ellipse at 20% 50%, rgba(31,122,99,0.15) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 20%, rgba(212,175,55,0.08) 0%, transparent 50%);
    pointer-events: none;
  }

  #page-loader.loader-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* ── Contenedor central ─────────────────────────────────── */
  .loader-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  /* ── Logo / Marca ───────────────────────────────────────── */
  .loader-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    animation: loader-brand-in 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .loader-emblem {
    filter: drop-shadow(0 8px 24px rgba(107,203,119,0.35));
    animation: loader-pulse 2.5s ease-in-out infinite;
  }

  .loader-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .loader-name {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .loader-name-accent {
    color: #6BCB77;
  }

  .loader-tagline {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
  }

  /* ── Barra de progreso ──────────────────────────────────── */
  .loader-bar-track {
    width: clamp(200px, 40vw, 320px);
    height: 2px;
    background: rgba(255,255,255,0.08);
    border-radius: 100px;
    overflow: hidden;
    position: relative;
  }

  .loader-bar-fill {
    height: 100%;
    width: 0%;
    border-radius: 100px;
    background: linear-gradient(90deg, #1F7A63, #6BCB77, #D4AF37);
    background-size: 200% 100%;
    animation:
      loader-progress 2.2s cubic-bezier(0.4, 0, 0.2, 1) forwards,
      loader-shimmer 1.5s linear infinite;
  }

  /* ── Spinner ────────────────────────────────────────────── */
  .loader-spinner {
    position: relative;
    width: 36px;
    height: 36px;
  }

  .spinner-ring {
    position: absolute;
    inset: 0;
    border: 2px solid rgba(107,203,119,0.15);
    border-top-color: #6BCB77;
    border-radius: 50%;
    animation: loader-spin 1s linear infinite;
  }

  /* ── Keyframes ──────────────────────────────────────────── */
  @keyframes loader-brand-in {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes loader-pulse {
    0%, 100% { transform: scale(1);     filter: drop-shadow(0 8px 24px rgba(107,203,119,0.35)); }
    50%       { transform: scale(1.06); filter: drop-shadow(0 12px 32px rgba(107,203,119,0.5)); }
  }

  @keyframes loader-progress {
    0%   { width: 0%; }
    30%  { width: 35%; }
    60%  { width: 68%; }
    85%  { width: 90%; }
    100% { width: 100%; }
  }

  @keyframes loader-shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  @keyframes loader-spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  (function () {
    const loader = document.getElementById('page-loader');
    if (!loader) return;

    function hideLoader() {
      loader.classList.add('loader-hidden');
      // Eliminar del DOM completamente tras la transición
      setTimeout(() => {
        if (loader.parentNode) loader.parentNode.removeChild(loader);
      }, 700);
    }

    // Si la página ya cargó (caché)
    if (document.readyState === 'complete') {
      setTimeout(hideLoader, 400);
      return;
    }

    // Esperar a que carguen todas las imágenes y recursos
    window.addEventListener('load', function () {
      // Pequeño delay mínimo para que la animación luzca completa
      setTimeout(hideLoader, 500);
    });

    // Fallback: ocultar tras 5s si algo falla
    setTimeout(hideLoader, 5000);
  })();
</script>
