---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/sections/Footer.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import { contact, lines } from '../data/site';

const hours = [
  { day: 'Lunes a viernes', time: '9:00 – 18:00 CET' },
  { day: 'Sábado', time: '10:00 – 14:00 CET' },
  { day: 'Domingo', time: 'Cerrado' },
];
---

<Layout
  title="Contacto — Nutriva Global | Distribuidores y Mayoristas"
  description="Contacta a Nutriva Global para información sobre distribución mayorista, pedidos al por mayor y alianzas comerciales. Respondemos en menos de 24 horas. Sede en Ámsterdam."
  keywords="contacto Nutriva Global, distribuidores alimentos saludables, mayorista alimentos orgánicos, alianza comercial alimentos internacionales"
>
  <Header />
  <main id="main-content">
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="wrap">
        <h1 id="contact-title" class="reveal-up">Hablemos de tu negocio</h1>
        <p class="lede reveal-up" style="--d:80ms">Seas distribuidor, retailer o consumidor, nuestro equipo te responde en menos de 24 horas hábiles. Para propuestas mayoristas, cuéntanos tu mercado y volúmenes.</p>
      </div>
    </section>

    <section class="contact-body" id="propuesta" aria-label="Formulario de contacto">
      <div class="wrap contact-grid">
        <div class="form-panel">
          <div class="success" id="form-success" role="status" hidden>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <div>
              <p class="success-title">Mensaje recibido</p>
              <p>Gracias. Un asesor te escribirá en menos de 24 horas hábiles.</p>
            </div>
          </div>

          <h2 class="form-title">Envíanos un mensaje</h2>

          <form class="contact-form" id="contact-form" action={contact.formAction} method="POST" novalidate>
            <input type="hidden" name="_subject" value="Nuevo contacto - Nutriva Global" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_next" value="https://www.nutrivaglobal.com/contacto?success=true" />
            <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="row">
              <div class="field">
                <label for="nombre">Nombre completo</label>
                <input type="text" id="nombre" name="nombre" class="input" autocomplete="name" required aria-describedby="nombre-err" />
                <p class="field-error" id="nombre-err" hidden>Escribe tu nombre.</p>
              </div>
              <div class="field">
                <label for="empresa">Empresa <span class="opt">(opcional)</span></label>
                <input type="text" id="empresa" name="empresa" class="input" autocomplete="organization" />
              </div>
            </div>

            <div class="row">
              <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" class="input" placeholder="tu@empresa.com" autocomplete="email" required aria-describedby="email-err" />
                <p class="field-error" id="email-err" hidden>Escribe un email válido, por ejemplo nombre@empresa.com.</p>
              </div>
              <div class="field">
                <label for="telefono">Teléfono o WhatsApp <span class="opt">(opcional)</span></label>
                <input type="tel" id="telefono" name="telefono" class="input" placeholder="+34 600 000 000" autocomplete="tel" />
              </div>
            </div>

            <div class="row">
              <div class="field">
                <label for="tipo">Tipo de consulta</label>
                <select id="tipo" name="tipo" class="input" required aria-describedby="tipo-err">
                  <option value="">Selecciona una opción</option>
                  <option value="distribuidor">Quiero ser distribuidor</option>
                  <option value="mayorista">Compra al por mayor</option>
                  <option value="retail">Retailer / tienda</option>
                  <option value="privatelabel">Private label</option>
                  <option value="consumidor">Consumidor final</option>
                  <option value="otro">Otra consulta</option>
                </select>
                <p class="field-error" id="tipo-err" hidden>Elige el tipo de consulta.</p>
              </div>
              <div class="field">
                <label for="pais">País de distribución <span class="opt">(opcional)</span></label>
                <input type="text" id="pais" name="pais" class="input" placeholder="¿Desde dónde operas?" autocomplete="country-name" />
              </div>
            </div>

            <fieldset class="field lines-field">
              <legend>Líneas de interés <span class="opt">(opcional)</span></legend>
              <div class="line-options">
                {lines.map((l) => (
                  <label class="line-option" style={`--field:${l.field}`}>
                    <input type="checkbox" name="lineas" value={l.name} />
                    <span>{l.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div class="field">
              <label for="mensaje">Mensaje</label>
              <textarea id="mensaje" name="mensaje" class="input" rows="5" placeholder="Cuéntanos sobre tu mercado, volúmenes o consulta." required aria-describedby="mensaje-err"></textarea>
              <p class="field-error" id="mensaje-err" hidden>Escribe tu mensaje.</p>
            </div>

            <button type="submit" class="btn btn--primary submit" id="form-submit-btn">
              <span class="submit-label">Enviar mensaje</span>
              <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
            <p class="form-foot">Usamos tus datos solo para responder a tu consulta.</p>
          </form>
        </div>

        <aside class="aside" aria-label="Contacto directo">
          <div class="aside-block aside-block--field">
            <h2 class="aside-title">¿Prefieres hablar ya?</h2>
            <p>Nuestro equipo de ventas internacionales atiende por WhatsApp en horario de oficina europeo.</p>
            <a href={contact.whatsappWithText} target="_blank" rel="noopener noreferrer" class="btn btn--primary">WhatsApp: {contact.phone}</a>
          </div>

          <dl class="aside-list">
            <div><dt>Email</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
            <div><dt>Sede</dt><dd>{contact.city}</dd></div>
            <div><dt>Instagram</dt><dd><a href={contact.instagram} target="_blank" rel="noopener noreferrer">@nutrivaglobal</a></dd></div>
            <div><dt>LinkedIn</dt><dd><a href={contact.linkedin} target="_blank" rel="noopener noreferrer">Nutriva Global</a></dd></div>
          </dl>

          <div class="hours">
            <h2 class="aside-title">Horario de atención</h2>
            <table>
              <caption class="sr-only">Horario de atención</caption>
              <tbody>
                {hours.map((h) => <tr><th scope="row">{h.day}</th><td>{h.time}</td></tr>)}
              </tbody>
            </table>
          </div>
        </aside>
      </div>
    </section>

    <FAQSection />
  </main>
  <Footer />
</Layout>

<style>
.contact-hero { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem); }
.contact-hero h1 { max-width: 10em; }
.contact-hero .lede { margin-top: 1.25rem; }

.contact-body { padding-bottom: var(--section); }
.contact-grid {
  display: grid;
  grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
  gap: clamp(2rem, 5vw, 5rem);
  align-items: start;
}

.form-panel {
  padding: clamp(1.5rem, 3.5vw, 2.75rem);
  border-radius: var(--radius-img);
  background: var(--oat);
}
.form-title { font-size: clamp(1.5rem, 2.4vw, 2rem); margin-bottom: 1.5rem; }

.contact-form { display: grid; gap: 1.125rem; }
.row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.125rem; }

.lines-field { border: 0; padding: 0; margin: 0; }
.lines-field legend { font-size: 0.875rem; font-weight: 600; margin-bottom: 0.5rem; padding: 0; }
.line-options { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.line-option {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 2.75rem;
  padding: 0.5rem 1rem;
  border: 1.5px solid var(--line-strong);
  border-radius: var(--radius-ctl);
  background: var(--paper);
  font-weight: 600;
  font-size: 0.9375rem;
  cursor: pointer;
  transition: background-color 160ms var(--ease-out), border-color 160ms var(--ease-out);
}
.line-option input { width: 1.05rem; height: 1.05rem; accent-color: var(--green); margin: 0; }
.line-option:hover { border-color: var(--ink-faint); }
.line-option:has(input:checked) { background: var(--field); border-color: var(--ink); }
.line-option:has(input:focus-visible) { outline: 3px solid var(--green); outline-offset: 2px; }

.submit { justify-self: start; min-height: 3.25rem; padding-inline: 2rem; font-size: 1.0625rem; }
.submit[aria-busy="true"] { opacity: 0.7; cursor: progress; }
.form-foot { font-size: 0.875rem; color: var(--ink-faint); }

.hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

.success {
  display: flex;
  gap: 0.875rem;
  align-items: flex-start;
  padding: 1.125rem 1.25rem;
  margin-bottom: 1.5rem;
  border-radius: var(--radius-card);
  background: var(--field-sage);
}
.success svg { flex-shrink: 0; color: var(--green); margin-top: 0.15rem; }
.success-title { font-weight: 700; }

.aside { display: grid; gap: 2rem; position: sticky; top: 110px; }
.aside-block--field {
  display: grid;
  gap: 1rem;
  justify-items: start;
  padding: 1.75rem;
  border-radius: var(--radius-img);
  background: var(--field-sage);
}
.aside-title { font-size: 1.375rem; }
.aside-block--field p { color: var(--ink-soft); }

.aside-list { margin: 0; display: grid; }
.aside-list div { display: grid; gap: 0.15rem; padding: 0.875rem 0; border-top: 1px solid var(--line-strong); }
.aside-list div:last-child { border-bottom: 1px solid var(--line-strong); }
.aside-list dt { font-size: 0.8125rem; font-weight: 600; color: var(--ink-faint); }
.aside-list dd { margin: 0; font-weight: 600; }
.aside-list a { text-decoration: underline; text-underline-offset: 0.25em; text-decoration-color: var(--line-strong); }
.aside-list a:hover { text-decoration-color: currentColor; color: var(--green); }

.hours table { width: 100%; border-collapse: collapse; margin-top: 0.75rem; font-variant-numeric: tabular-nums; }
.hours th, .hours td { padding: 0.5rem 0; text-align: left; border-bottom: 1px solid var(--line); font-size: 0.9375rem; }
.hours th { font-weight: 500; color: var(--ink-soft); }
.hours td { text-align: right; font-weight: 600; }

@media (max-width: 960px) {
  .contact-grid { grid-template-columns: 1fr; }
  .aside { position: static; }
}
@media (max-width: 600px) {
  .row { grid-template-columns: 1fr; }
  .submit { width: 100%; }
}
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  // Confirmación tras el envío (formsubmit redirige con ?success=true)
  if (params.get('success') === 'true') {
    const ok = document.getElementById('form-success');
    if (ok) ok.hidden = false;
  }

  // Prefill desde las páginas de categoría: ?linea=...&producto=...
  const linea = params.get('linea');
  const producto = params.get('producto');
  if (form && (linea || producto)) {
    form.querySelectorAll<HTMLInputElement>('input[name="lineas"]').forEach((cb) => {
      if (cb.value === linea) cb.checked = true;
    });
    const tipo = form.querySelector<HTMLSelectElement>('#tipo');
    if (tipo && !tipo.value) tipo.value = 'mayorista';
    const msg = form.querySelector<HTMLTextAreaElement>('#mensaje');
    if (msg && !msg.value) {
      msg.value = producto
        ? `Hola, me interesa ${producto} (${linea}). ¿Podrían enviarme condiciones mayoristas y fichas técnicas?`
        : `Hola, me interesa la línea ${linea}. ¿Podrían enviarme la propuesta mayorista?`;
    }
  }

  // Validación accesible en línea
  const rules: Record<string, (el: HTMLInputElement) => boolean> = {
    nombre: (el) => el.value.trim().length > 1,
    email: (el) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim()),
    tipo: (el) => el.value !== '',
    mensaje: (el) => el.value.trim().length > 4,
  };

  const check = (name: string) => {
    const el = form?.querySelector<HTMLInputElement>(`#${name}`);
    const err = document.getElementById(`${name}-err`);
    if (!el || !err) return true;
    const valid = rules[name](el);
    el.setAttribute('aria-invalid', String(!valid));
    err.hidden = valid;
    return valid;
  };

  Object.keys(rules).forEach((name) => {
    const el = form?.querySelector<HTMLInputElement>(`#${name}`);
    el?.addEventListener('blur', () => { if (el.value) check(name); });
    el?.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true') check(name); });
  });

  form?.addEventListener('submit', (e) => {
    const results = Object.keys(rules).map(check);
    if (results.includes(false)) {
      e.preventDefault();
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      return;
    }
    const btn = document.getElementById('form-submit-btn');
    btn?.setAttribute('aria-busy', 'true');
    const label = btn?.querySelector('.submit-label');
    if (label) label.textContent = 'Enviando…';
  });
</script>
