---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/sections/Footer.astro';
import FAQSection from '../components/sections/FAQSection.astro';
---

<Layout
  title="Contacto — Nutriva Global | Distribuidores y Mayoristas"
  description="Contacta a Nutriva Global para información sobre distribución mayorista, pedidos al por mayor y alianzas comerciales. Respondemos en menos de 24 horas. Sede en Ámsterdam."
  keywords="contacto Nutriva Global, distribuidores alimentos saludables, mayorista alimentos orgánicos, alianza comercial alimentos internacionales"
>
  <Header />
  <main id="main-content">

    <section class="contact-hero" aria-label="Contacto Nutriva Global">
      <div class="container-xl contact-hero-inner">
        <div>
          <p class="section-label gsap-reveal">Contacto</p>
          <h1 class="gsap-reveal">Hablemos de<br/><span class="text-gradient">tu negocio</span></h1>
          <p class="contact-hero-desc gsap-reveal">Tanto si eres un consumidor con preguntas como un distribuidor buscando un proveedor confiable, nuestro equipo está listo para atenderte en menos de 24 horas.</p>
        </div>
        <div class="contact-info-cards gsap-reveal-right">
          <div class="cinfo-card">
            <div class="cinfo-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.6a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 3h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 10.9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 17z"/></svg>
            </div>
            <div>
              <div class="cinfo-label">WhatsApp / Teléfono</div>
              <a href="https://wa.me/31201234567" title="WhatsApp Nutriva Global" class="cinfo-value" target="_blank" rel="noopener noreferrer">+31 20 123 4567</a>
            </div>
          </div>
          <div class="cinfo-card">
            <div class="cinfo-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <div class="cinfo-label">Email</div>
              <a href="mailto:info@nutrivaglobal.com" title="Email Nutriva Global" class="cinfo-value">info@nutrivaglobal.com</a>
            </div>
          </div>
          <div class="cinfo-card">
            <div class="cinfo-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <div class="cinfo-label">Sede Principal</div>
              <span class="cinfo-value">Ámsterdam, Países Bajos</span>
            </div>
          </div>
          <div class="cinfo-card">
            <div class="cinfo-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </div>
            <div>
              <div class="cinfo-label">Instagram</div>
              <a href="https://www.instagram.com/nutrivaglobal" title="Instagram Nutriva Global" class="cinfo-value" target="_blank" rel="noopener noreferrer">@nutrivaglobal</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FORMULARIO + INFO -->
    <section class="section-pad" id="mayoristas" aria-label="Formulario de contacto">
      <div class="container-xl contact-grid">

        <div class="form-section gsap-reveal-left">
          <h2>Envíanos un mensaje</h2>
          <p class="form-subtitle">Completa el formulario y te respondemos en menos de 24 horas hábiles.</p>

          <form class="contact-form" id="contact-form" action="https://formsubmit.co/info@nutrivaglobal.com" method="POST" novalidate>
            <input type="hidden" name="_subject" value="Nuevo contacto - Nutriva Global" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_next" value="https://www.nutrivaglobal.com/contacto?success=true" />

            <div class="form-row">
              <div class="form-group">
                <label for="nombre" class="form-label">Nombre completo *</label>
                <input type="text" id="nombre" name="nombre" class="form-input" placeholder="Tu nombre" required aria-required="true" />
              </div>
              <div class="form-group">
                <label for="empresa" class="form-label">Empresa (opcional)</label>
                <input type="text" id="empresa" name="empresa" class="form-input" placeholder="Tu empresa" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="email" class="form-label">Email *</label>
                <input type="email" id="email" name="email" class="form-input" placeholder="tu@email.com" required aria-required="true" />
              </div>
              <div class="form-group">
                <label for="telefono" class="form-label">Teléfono / WhatsApp</label>
                <input type="tel" id="telefono" name="telefono" class="form-input" placeholder="+1 234 567 8900" />
              </div>
            </div>

            <div class="form-group">
              <label for="tipo" class="form-label">Tipo de consulta *</label>
              <select id="tipo" name="tipo" class="form-select" required aria-required="true">
                <option value="">Selecciona una opción</option>
                <option value="distribuidor">Quiero ser distribuidor</option>
                <option value="mayorista">Compra al por mayor</option>
                <option value="retail">Retailer / Tienda</option>
                <option value="consumidor">Consumidor final</option>
                <option value="privatelabel">Private Label</option>
                <option value="otro">Otra consulta</option>
              </select>
            </div>

            <div class="form-group">
              <label for="pais" class="form-label">País de distribución</label>
              <input type="text" id="pais" name="pais" class="form-input" placeholder="¿Desde dónde operas?" />
            </div>

            <div class="form-group">
              <label for="mensaje" class="form-label">Mensaje *</label>
              <textarea id="mensaje" name="mensaje" class="form-textarea" rows="5" placeholder="Cuéntanos sobre tu proyecto o consulta..." required aria-required="true"></textarea>
            </div>

            <button type="submit" class="btn-primary form-submit" id="form-submit-btn">
              Enviar mensaje
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </form>
        </div>

        <div class="contact-aside gsap-reveal-right">
          <div class="aside-card">
            <h3>¿Prefieres contacto directo?</h3>
            <p>Nuestro equipo de ventas internacionales está disponible para atenderte por WhatsApp en horario de oficina europeo.</p>
            <a href="https://wa.me/31201234567?text=Hola%20Nutriva%20Global%2C%20me%20interesa%20conocer%20sus%20productos%20y%20condiciones%20de%20distribución." title="WhatsApp Nutriva Global" target="_blank" rel="noopener noreferrer" class="btn-primary whatsapp-btn" id="contact-whatsapp-direct">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              WhatsApp ahora
            </a>
          </div>

          <div class="aside-card" style="margin-top:1.25rem;">
            <h3>Horario de atención</h3>
            <div class="horario-list">
              <div class="horario-item"><span>Lunes – Viernes</span><span>9:00 – 18:00 CET</span></div>
              <div class="horario-item"><span>Sábado</span><span>10:00 – 14:00 CET</span></div>
              <div class="horario-item"><span>Domingo</span><span>Cerrado</span></div>
            </div>
          </div>

          <div class="aside-card" style="margin-top:1.25rem;">
            <h3>Síguenos en redes</h3>
            <div class="social-links">
              <a href="https://www.instagram.com/nutrivaglobal" title="Instagram Nutriva Global" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                @nutrivaglobal
              </a>
              <a href="https://www.linkedin.com/company/nutriva-global" title="LinkedIn Nutriva Global" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                Nutriva Global
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <FAQSection />
  </main>
  <Footer />
</Layout>

<style>
.contact-hero { background: linear-gradient(135deg, #f9fbf9 0%, var(--beige) 100%); padding: calc(72px + 4rem) 0 5rem; }
.contact-hero-inner { display: grid; grid-template-columns: 1fr 1.2fr; align-items: center; gap: 5rem; }
.contact-hero-inner h1 { font-size: clamp(2.4rem, 4.5vw, 3.8rem); font-weight: 900; margin: 0.5rem 0 1.25rem; }
.contact-hero-desc { font-size: 1.05rem; max-width: 440px; }

.contact-info-cards { display: flex; flex-direction: column; gap: 1rem; }
.cinfo-card { display: flex; align-items: center; gap: 1rem; padding: 1.25rem 1.5rem; background: white; border: 1px solid var(--gray-mid); border-radius: var(--radius-md); transition: all var(--transition); }
.cinfo-card:hover { border-color: rgba(31,122,99,0.3); box-shadow: var(--shadow-sm); }
.cinfo-icon { width: 40px; height: 40px; border-radius: 8px; background: rgba(31,122,99,0.08); display: flex; align-items: center; justify-content: center; color: var(--verde-deep); flex-shrink: 0; }
.cinfo-label { font-family: var(--font-heading); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.15rem; }
.cinfo-value { font-family: var(--font-heading); font-size: 0.95rem; font-weight: 600; color: var(--verde-deep); text-decoration: none; transition: color var(--transition); }
.cinfo-value:hover { color: var(--gold); }

.contact-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 4rem; align-items: start; }

.form-section h2 { margin-bottom: 0.5rem; }
.form-subtitle { font-size: 0.95rem; margin-bottom: 2rem; }

.contact-form { display: flex; flex-direction: column; gap: 1.25rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
.form-group { display: flex; flex-direction: column; gap: 0.4rem; }
.form-label { font-family: var(--font-heading); font-size: 0.82rem; font-weight: 600; color: var(--carbon); }
.form-input, .form-select, .form-textarea {
  padding: 0.85rem 1rem;
  border: 1.5px solid var(--gray-mid);
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: 0.92rem;
  color: var(--carbon);
  background: white;
  transition: border-color var(--transition);
  width: 100%;
}
.form-input:focus, .form-select:focus, .form-textarea:focus {
  outline: none;
  border-color: var(--verde-deep);
  box-shadow: 0 0 0 3px rgba(31,122,99,0.1);
}
.form-textarea { resize: vertical; min-height: 120px; }
.form-submit { width: 100%; justify-content: center; padding: 1rem; font-size: 1rem; }

.aside-card { padding: 1.75rem; background: var(--gray-soft); border: 1px solid var(--gray-mid); border-radius: var(--radius-lg); }
.aside-card h3 { font-size: 1rem; margin-bottom: 0.6rem; }
.aside-card p { font-size: 0.88rem; margin-bottom: 1.25rem; }
.whatsapp-btn { width: 100%; justify-content: center; }

.horario-list { display: flex; flex-direction: column; gap: 0.5rem; }
.horario-item { display: flex; justify-content: space-between; font-size: 0.88rem; padding: 0.5rem 0; border-bottom: 1px solid var(--gray-mid); }
.horario-item:last-child { border-bottom: none; }
.horario-item span:first-child { color: var(--carbon); font-weight: 500; }
.horario-item span:last-child { color: var(--text-muted); }

.social-links { display: flex; flex-direction: column; gap: 0.65rem; }
.social-btn { display: flex; align-items: center; gap: 0.65rem; padding: 0.75rem 1rem; background: white; border: 1px solid var(--gray-mid); border-radius: var(--radius-md); font-family: var(--font-heading); font-size: 0.88rem; font-weight: 600; color: var(--carbon); transition: all var(--transition); }
.social-btn:hover { border-color: var(--verde-deep); color: var(--verde-deep); }
.social-btn svg { color: var(--verde-deep); }

@media (max-width: 960px) {
  .contact-hero-inner, .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
}
@media (max-width: 560px) {
  .form-row { grid-template-columns: 1fr; }
}
</style>


