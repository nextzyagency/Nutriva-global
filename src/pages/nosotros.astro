---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/sections/Footer.astro';
import CTASection from '../components/sections/CTASection.astro';
import ExampleNote from '../components/ui/ExampleNote.astro';
import Figures from '../components/ui/Figures.astro';
import FactList from '../components/ui/FactList.astro';
import aboutImg from '../assets/about_team.png';

const timeline = [
  { year: '2018', event: 'Fundación en Ámsterdam. Primeros 3 productos y distribución local en Países Bajos.' },
  { year: '2019', event: 'Expansión a Alemania, Francia y España. Certificación EU Organic.' },
  { year: '2020', event: 'Entrada a LATAM: Colombia, México y Brasil. Lanzamiento de la línea plant-based.' },
  { year: '2022', event: 'Expansión a Asia: Japón y Corea del Sur. Certificación Non-GMO Verified.' },
  { year: '2024', event: 'Más de 20 países activos. Línea de superfoods con quinoa andina certificada.' },
];

const purpose = [
  { title: 'Misión', desc: 'Proporcionar alimentos saludables, accesibles y de alta calidad a nivel global, promoviendo un estilo de vida equilibrado e impulsando prácticas sostenibles en toda la cadena de producción.' },
  { title: 'Visión', desc: 'Convertirnos en la marca líder mundial en alimentación consciente, impactando positivamente la salud de millones de personas y el cuidado del planeta.' },
  { title: 'Valores', desc: 'Calidad sin compromisos, transparencia total, sostenibilidad real y accesibilidad global. No competimos por precio bajo: competimos por valor y confianza.' },
];

const differentiators = [
  { title: 'Trazabilidad real', desc: 'Cada producto tiene un código QR vinculado al lote, al productor y al análisis de laboratorio independiente.' },
  { title: 'Red propia de productores', desc: 'No somos intermediarios: trabajamos directamente con 47 productores certificados en 12 países.' },
  { title: 'Formulación científica', desc: 'Nutricionistas y food scientists diseñan cada producto para maximizar la biodisponibilidad de nutrientes.' },
  { title: 'Logística global propia', desc: 'Red de distribución internacional directa, con control de tiempo, temperatura y trazabilidad del envío.' },
];

const figures = [
  { num: '20+', label: 'países con distribución activa' },
  { num: '47', label: 'productores certificados en 12 países' },
  { num: '98 %', label: 'satisfacción en la encuesta a distribuidores 2024' },
];
---

<Layout
  title="Sobre Nosotros — Nutriva Global | Alimentos Saludables con Propósito"
  description="Conoce Nutriva Global, empresa internacional de alimentos saludables fundada en Ámsterdam. Nuestra misión: nutrición accesible, sostenible y de calidad certificada para el mundo."
  keywords="Nutriva Global empresa, alimentos saludables Ámsterdam, empresa alimentación consciente global, distribución alimentos orgánicos internacional"
>
  <Header />
  <main id="main-content">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="wrap about-hero-grid">
        <div>
          <h1 id="about-title" class="reveal-up">Nutriendo el mundo, naturalmente.</h1>
          <p class="lede reveal-up" style="--d:80ms">Somos una empresa internacional de alimentos saludables, sostenibles y accesibles. Desde Ámsterdam distribuimos productos certificados a retailers y distribuidores que exigen calidad, transparencia y compromiso con el planeta.</p>
        </div>
        <div class="about-hero-media reveal-img">
          <Image src={aboutImg} alt="Equipo de Nutriva Global en Ámsterdam" widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 44vw" loading="eager" fetchpriority="high" class="about-hero-img" />
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="story-title">
      <div class="wrap story-grid">
        <div class="story-text">
          <h2 id="story-title">Nacimos para resolver un problema real</h2>
          <p>En 2018, un grupo de nutricionistas, empresarios de alimentos y expertos en distribución internacional identificó un vacío: el mercado global de alimentos saludables estaba fragmentado, lleno de productos de dudosa calidad y sin trazabilidad verificable.</p>
          <p>Los consumidores conscientes de Europa y LATAM querían opciones orgánicas, certificadas y accesibles. Los distribuidores buscaban un proveedor confiable con capacidad global real.</p>
          <p>Nutriva Global nació en Ámsterdam como respuesta a ese mercado desatendido. Hoy distribuimos en cuatro continentes con el mismo compromiso de calidad del primer día.</p>
        </div>

        <div>
          <ol class="timeline" role="list" aria-label="Historia de Nutriva Global">
            {timeline.map((t) => (
              <li>
                <span class="tl-year">{t.year}</span>
                <span class="tl-event">{t.event}</span>
              </li>
            ))}
          </ol>
          <ExampleNote />
        </div>
      </div>
    </section>

    <section class="section section--oat" aria-labelledby="purpose-title">
      <div class="wrap">
        <div class="section-head"><h2 id="purpose-title">Misión, visión y valores</h2></div>
        <FactList items={purpose} columns={3} />
      </div>
    </section>

    <section class="section" aria-labelledby="diff-title">
      <div class="wrap diff-grid">
        <div>
          <h2 id="diff-title">Lo que nos hace distintos</h2>
          <div class="diff-figures"><Figures figures={figures} /></div>
        </div>
        <FactList items={differentiators} columns={2} />
      </div>
    </section>

    <CTASection />
  </main>
  <Footer />
</Layout>

<style>
.about-hero {
  background: var(--field-oat);
  padding-block: clamp(2.5rem, 6vw, 5rem);
}
.about-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: clamp(2rem, 5vw, 5rem);
  align-items: center;
}
.about-hero h1 { max-width: 9em; }
.about-hero .lede { margin-top: 1.5rem; color: var(--ink); opacity: 0.85; }
.about-hero-media { aspect-ratio: 5 / 4; border-radius: var(--radius-img); overflow: hidden; }
.about-hero-img { width: 100%; height: 100%; object-fit: cover; }

.story-grid {
  display: grid;
  grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
  gap: clamp(2rem, 6vw, 6rem);
  align-items: start;
}
.story-text h2 { margin-bottom: 1.5rem; }
.story-text p { color: var(--ink-soft); font-size: 1.125rem; max-width: 34em; }
.story-text p + p { margin-top: 1rem; }

.timeline { list-style: none; padding: 0; margin: 0 0 0.875rem; }
.timeline li {
  display: grid;
  grid-template-columns: 5.5rem 1fr;
  gap: 1rem;
  padding: 1.125rem 0;
  border-top: 1px solid var(--line-strong);
}
.timeline li:last-child { border-bottom: 1px solid var(--line-strong); }
.tl-year {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.tl-event { color: var(--ink-soft); }

.diff-grid {
  display: grid;
  grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
  gap: clamp(2rem, 6vw, 6rem);
  align-items: start;
}
.diff-figures { margin-top: 2rem; }

@media (max-width: 900px) {
  .about-hero-grid, .story-grid, .diff-grid { grid-template-columns: 1fr; }
}
</style>
